<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

    <!-- In .targets so the project's own UsesTUnit is visible: xunit v3 generates an entry point that clashes with TUnit's -->
    <ItemGroup Condition="'$(UsesTUnit)' != 'true' And $(MSBuildProjectName.EndsWith('.Tests'))">
        <!-- mtp-off: the default xunit.v3 variant pulls Microsoft.Testing.Extensions.Telemetry; CI runs through VSTest anyway -->
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="GitHubActionsTestLogger" />
    </ItemGroup>

    <!-- Projects without a Startup.cs opt out with UsesXunitDI=false -->
    <ItemGroup Condition="'$(UsesTUnit)' != 'true' And '$(UsesXunitDI)' != 'false'">
        <PackageReference Include="Xunit.DependencyInjection" />
        <PackageReference Include="Xunit.DependencyInjection.Logging" />
    </ItemGroup>

    <!-- Shared test helper libraries only need the xunit abstractions -->
    <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
        <PackageReference Include="xunit.v3.extensibility.core" />
        <PackageReference Include="xunit.v3.assert" />
    </ItemGroup>
</Project>
